# =============================================================================
# Authentication — NextAuth v5 + Google OIDC (SSD201 GCP fork)
# =============================================================================
# All four variables are REQUIRED. AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET must
# both be set together (partial config is rejected by validateEnv() at startup).
# See docs/ENVIRONMENT_VARIABLES.md for full reference.

AUTH_URL=http://localhost:3000
AUTH_SECRET=    # openssl rand -base64 32

# Google OAuth 2.0 credentials — create at:
# https://console.cloud.google.com/apis/credentials
# Add this authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# =============================================================================
# Database Configuration (exactly one mode required)
# =============================================================================

# Mode 1 — Local dev (Docker PostgreSQL, run: bun run db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aistudio
DB_SSL=false

# Mode 2 — TCP connection (Cloud SQL via IP / VPN)
# DB_HOST=your-cloud-sql-ip
# DB_PORT=5432
# DB_USER=aistudio
# DB_PASSWORD=
# DB_NAME=aistudio
# DB_SSL=true

# Mode 3 — Cloud Run (Unix socket via Cloud SQL Auth Proxy — recommended)
# CLOUD_SQL_SOCKET_PATH=/cloudsql/my-project:us-central1:my-instance
# DB_USER=aistudio
# DB_PASSWORD=
# DB_NAME=aistudio

# Connection pool tuning (optional)
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT=20
# DB_CONNECT_TIMEOUT=10

# Optional — log all SQL queries (dev only, never enable in production)
SQL_LOGGING=false

# =============================================================================
# Storage — Google Cloud Storage
# =============================================================================
GCS_BUCKET_NAME=    # Required — set to your GCS bucket name

# =============================================================================
# Session / Token (optional overrides)
# =============================================================================
# SESSION_MAX_AGE=86400             # JWT session lifetime in seconds (default: 24 h)
# TOKEN_REFRESH_THRESHOLD_MS=300000 # Proactive refresh window in ms (default: 5 min)

# =============================================================================
# AI Model Providers (optional — fallback if not configured in admin DB)
# =============================================================================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE_NAME=

# Google Vertex AI (uses Application Default Credentials — no API key needed)
# Locally: gcloud auth application-default login
# On GCP: workload identity / service account used automatically
# VERTEX_AI_ENABLED=false
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=  # Optional: path to service account JSON

# =============================================================================
# MCP Connector Token Encryption (local dev only)
# =============================================================================
# In production, the DEK is fetched from GCP Secret Manager.
# For local dev, set any random string to skip the Secret Manager call.
# Example: openssl rand -base64 32
# MCP_TOKEN_ENCRYPTION_KEY=
