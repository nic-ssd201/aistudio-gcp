# Bootstrap — staging environment
# Copy to staging.tfvars (gitignored) and fill in real values.
#
# Apply with:
#   terraform init \
#     -backend-config="bucket=ssd201-aistudio-tfstate-shared" \
#     -backend-config="prefix=bootstrap/staging"
#   terraform apply -var-file=staging.tfvars

env             = "staging"
host_project_id = "ssd201-aistudio-shared"
env_project_id  = "ssd201-aistudio-staging"

# GCP org / billing
org_id          = "123456789012"
billing_account = "XXXXXX-XXXXXX-XXXXXX"

region = "us-west1"

github_repo = "nic-ssd201/aistudio-gcp"

# Breakglass email — same shared mailbox as dev; each env creates its own channel resource.
breakglass_email = "it-breakglass@sunnysideschools.org"

# Budget — $2000/mo for staging; alert at 50/80/100%
budget_amount_usd         = 2000
budget_threshold_percents = [0.5, 0.8, 1.0]

# Populate after first observability apply.
budget_notification_channels = []
