# Bootstrap — dev environment
# Copy to dev.tfvars (gitignored) and fill in real values.
#
# Apply with:
#   terraform init \
#     -backend-config="bucket=ssd201-aistudio-tfstate-shared" \
#     -backend-config="prefix=bootstrap/dev"
#   terraform apply -var-file=dev.tfvars

env             = "dev"
host_project_id = "ssd201-aistudio-shared"
env_project_id  = "ssd201-aistudio-dev"

# GCP org / billing (from: gcloud organizations list, gcloud billing accounts list)
org_id          = "123456789012"
billing_account = "XXXXXX-XXXXXX-XXXXXX"

region = "us-west1"

# GitHub repo for WIF subject claim
github_repo = "nic-ssd201/aistudio-gcp"

# Breakglass email — receives budget alerts immediately, before observability channels exist.
# Use a shared mailbox that the IT team monitors; do not use a personal address.
breakglass_email = "it-breakglass@sunnysideschools.org"

# Budget — $500/mo for dev; alert at 50/80/100% current-spend
budget_amount_usd         = 500
budget_threshold_percents = [0.5, 0.8, 1.0]

# Observability notification channel IDs (optional — populate after first observability apply).
# Format: ["projects/PROJECT/notificationChannels/CHANNEL_ID"]
# If empty, the breakglass email channel is used automatically.
budget_notification_channels = []
